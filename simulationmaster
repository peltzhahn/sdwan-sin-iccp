def realizar_calibracao_rtt(tg, rodadas=100):
    print(f"\n[CALIBRAÇÃO] Iniciando {rodadas} rodadas (pares aleatórios) para cálculo do Timeout...")
    amostras_rtt = []
    
    global rnp_nodes
    global lan_lat
    global BITS_MIN
    global BITS_MAX

    network_calib, _ = tg.generateNetwork("rnp")

    def get_node_bw_mbps(node_name, network_obj):
        edges = network_obj.edges(node_name, data=True)
        if not edges: return 0
        bws_mbps = [data['bandwidth'] for _, _, data in edges]
        return max(bws_mbps)

    for _ in range(rodadas):
        bits_calib = random.randint(BITS_MIN, BITS_MAX)
        try:
            node_origem, node_destino = random.sample(rnp_nodes, 2)
        except ValueError:
            continue 

        path, _ = gerar_caminho_wan(tg, "rnp", node_origem, node_destino, bits_calib)
        if not path: continue 

        lan_bw_origem = get_node_bw_mbps(node_origem, network_calib)
        lan_bw_destino = get_node_bw_mbps(node_destino, network_calib)

        tempo_total = 0.0
        tempo_total += (bits_calib/(lan_bw_origem*1e6)) + (lan_lat/1000.)
        for _, _, bits, bw, lat, _ in path:
            tempo_total += (bits/(bw*1e6)) + (lat/1000.)
        tempo_total += (bits_calib/(lan_bw_destino*1e6)) + (lan_lat/1000.)

        rtt = tempo_total * 2
        amostras_rtt.append(rtt)

    if not amostras_rtt: return 0.5
    avg_rtt = np.mean(amostras_rtt)
    dev_rtt = np.std(amostras_rtt)
    int_to = avg_rtt + (4 * dev_rtt)

    print(f"  > Amostras válidas: {len(amostras_rtt)}")
    print(f"  > RTT Médio (Global): {avg_rtt*1000:.2f} ms | Desvio: {dev_rtt*1000:.2f} ms")
    print(f"  > Timeout Calculado (IntTO): {int_to*1000:.2f} ms")
    return int_to, avg_rtt

