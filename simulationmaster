    print("-" * 120)

    for mode in ["Trad", "Trad_Res", "SDN", "SDN_Res"]:
        data = res_dict[mode]
        
        if not data:
            print(f"{mode:<15} | N/A")
            continue

        # Extração dos dados brutos das 1000 rodadas
        # A estrutura de 'd' é [TempoTotal, Perdas, Violou?, TempoIndisponivel]
        raw_times = np.array([d[0] for d in data])
        raw_losses = np.array([d[1] for d in data])
        
        # Proteção: Se por algum motivo o código antigo rodou e não tem o índice 3, assume 0.0
        try:
            raw_unavailable = np.array([d[3] for d in data])
        except IndexError:
            raw_unavailable = np.zeros_like(raw_times)

        # --- 1. Estatística de DELAY (ms) ---
        arr_delay = raw_times * 1000
        mean_delay, ci_delay = calc_stats(arr_delay, confidence=0.95)

        # --- 2. Estatística de JITTER (ms) ---
        # Jitter calculado pela diferença absoluta entre rodadas consecutivas
        if len(arr_delay) > 1:
            arr_jitter = np.abs(np.diff(arr_delay))
            mean_jitter, ci_jitter = calc_stats(arr_jitter, confidence=0.95)
        else:
            mean_jitter, ci_jitter = 0.0, 0.0

        # --- 3. Estatística de PERDAS (%) ---
        # Cálculo: Perda na rodada = Perdas / (Perdas + 1 Sucesso)
        # Se raw_losses for 0, perda é 0%. Se for 1, perda é 50% (1 falha, 1 sucesso), etc.
        # Nota: Dependendo da lógica exata, o denominador é 'Tentativas'. 
        # Assumindo que 1 sucesso sempre ocorre no final ou o pacote chega:
        total_attempts_per_round = raw_losses + 1 
        arr_loss_perc = (raw_losses / total_attempts_per_round) * 100
        mean_loss, ci_loss = calc_stats(arr_loss_perc, confidence=0.95)

        # --- 4. Estatística de DISPONIBILIDADE (%) ---
        # Disp = ((TempoTotal - TempoIndisponivel) / TempoTotal) * 100
        with np.errstate(divide='ignore', invalid='ignore'):
            arr_avail_perc = ((raw_times - raw_unavailable) / raw_times) * 100
            # Corrige NaN/Inf caso tempo seja 0 (improvável, mas seguro)
            arr_avail_perc = np.nan_to_num(arr_avail_perc, nan=0.0)
        
        mean_avail, ci_avail = calc_stats(arr_avail_perc, confidence=0.95)

        # --- IMPRESSÃO FORMATADA ---
        # Formata como "Média ±Margem"
        str_delay = f"{mean_delay:.2f} ±{ci_delay:.2f}"
        str_jitter = f"{mean_jitter:.2f} ±{ci_jitter:.2f}"
        str_loss = f"{mean_loss:.2f} ±{ci_loss:.2f}"
        str_avail = f"{mean_avail:.2f} ±{ci_avail:.2f}"

        print(f"{mode:<15} | {str_delay:<22} | {str_jitter:<22} | {str_loss:<22} | {str_avail:<22}")

