# Função Auxiliar para calcular Média e Margem de Erro (IC)
def calc_stats(data_array, confidence=0.95):
    # Se não houver dados suficientes, retorna 0
    if len(data_array) < 2: return np.mean(data_array), 0.0
    
    n = len(data_array)
    mean = np.mean(data_array)
    sem = st.sem(data_array) # Erro Padrão da Média
    
    # Margem de erro usando T-Student
    # st.t.ppf calcula o valor crítico T para a confiança desejada
    margin = sem * st.t.ppf((1 + confidence) / 2., n-1)
    
    return mean, margin

