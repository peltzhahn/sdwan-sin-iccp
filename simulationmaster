def simular_tradicional(links, reqlat, eventos_perda, int_to, verbose=False):
    global black_hole_state, total_packets_sent_simulada, total_packets_lost_simulada

    acumulado = [0, 0, False, 0.0]
    l = 0
    perda_idx = 0
    tempo_viagem_pacote = 0.0

    if verbose: print(f"[TRAD] Iniciando transmissão. Timeout TCP: {int_to*1000:.0f}ms")

    while (l < len(links)):
        u, v, bits, bw, lat_prop_ms, lr = links[l]
        atraso_tx = bits / (bw * (10**6))
        atraso_prop = lat_prop_ms / 1000.
        passo = atraso_tx + atraso_prop
        momento_chegada_destino_link = acumulado[0] + tempo_viagem_pacote + passo

        if perda_idx >= len(eventos_perda): break
        
        is_lan_man = (lr == TAXA_PERDA_LR)
        perda_detectada = False
        motivo = ""

        link_esta_quebrado = (u == black_hole_state['u'] and v == black_hole_state['v'])
        dentro_janela_tempo = (momento_chegada_destino_link < black_hole_state['active_until'])

        if link_esta_quebrado and dentro_janela_tempo and is_lan_man:
            perda_detectada = True
            motivo = f"Buraco Negro Ativo (Físico em {u}->{v})"
        elif eventos_perda[perda_idx] <= lr:
            perda_detectada = True
            motivo = "Erro de Bit"
            if is_lan_man and momento_chegada_destino_link >= black_hole_state['active_until']:
                black_hole_state['u'] = u
                black_hole_state['v'] = v
                black_hole_state['active_until'] = momento_chegada_destino_link + FAIL_DURATION
                motivo = "NOVA FALHA DE ROTA -> Erro de Roteamento"

        total_packets_sent_simulada += 1

        if verbose:
            log_msg = f"  > {u}->{v} | T_sim: {momento_chegada_destino_link:.4f}s"
            if perda_detectada: print(f"{log_msg} [FALHA: {motivo}]")
            else: print(f"{log_msg} [OK]")

        if perda_detectada:
            acumulado[1] += 1
            total_packets_lost_simulada += 1
            tempo_espera = int_to

            tempo_perdido_nesta_falha = tempo_espera + tempo_viagem_pacote
            acumulado[3] += tempo_perdido_nesta_falha

            acumulado[0] += tempo_espera
            # TRADICIONAL: Soma o tempo gasto na viagem falha
            acumulado[0] += tempo_viagem_pacote 
            
            if verbose: print(f"    [!] Aguardando Timeout (+{tempo_espera:.4f}s) para retransmitir...")
            l = 0
            tempo_viagem_pacote = 0.0
        else:
            tempo_viagem_pacote += passo
            l += 1
        perda_idx += 1

    acumulado[0] += tempo_viagem_pacote
    if (acumulado[0] >= reqlat): acumulado[2] = True
    if verbose: print(f"[FIM TRAD] Tempo Total: {acumulado[0]:.4f}s | Perdas: {acumulado[1]}")
    return acumulado

# --- FUNÇÃO SDN  ---
def simular_sdn(links, reqlat, eventos_perda, lat_ctrl, int_to, verbose=False):
    global total_packets_sent_simulada, total_packets_lost_simulada

    acumulado = [0, 0, False, 0.0] 
    no_destino_final = links[-1][1]
    
    # Setup Visual
    if verbose: print(f"[SDN] Iniciando transmissão (Controller Latency: {lat_ctrl*1000:.1f}ms)...")

    rota_atual = list(links)
    l = 0
    perda_idx = 0
    tempo_viagem_neste_trecho = 0.0

    while (l < len(rota_atual)):
        u, v, bits, bw, lat_prop_ms, lr = rota_atual[l]
        passo = (bits / (bw * 1e6)) + (lat_prop_ms / 1000.)
        
        # Momento em que o pacote CHEGARIA ao final deste link
        momento_atual = acumulado[0] + tempo_viagem_neste_trecho + passo

        if perda_idx >= len(eventos_perda): break
        
        is_physical_fail = (lr == TAXA_PERDA_LR) 
        prefixes_lan = ('serv', 'fw', 'gate', 'sw', 'core')
        eh_lan = u.startswith(prefixes_lan) or v.startswith(prefixes_lan)
        perda = False

        if eventos_perda[perda_idx] <= lr:
            if eh_lan and is_physical_fail:
                perda = False # LAN protegida
            else:
                perda = True 

            if perda:
                # === CENÁRIO 1: FALHA FÍSICA NA WAN  ===
                if is_physical_fail and not eh_lan:
                    tempo_ida = lat_ctrl
                    tempo_volta = lat_ctrl
                    penalidade = tempo_ida + tempo_volta
                    
                    acumulado[3] += penalidade                    

                    acumulado[0] += penalidade
                    
                    if verbose: print(f"  [SDN] FALHA FÍSICA em {u}->{v}. Reroteando (+{penalidade:.4f}s)...")
                    
                    
                    novos_links, _ = gerar_caminho_wan_k(tg, "rnp", u, no_destino_final, bits, k=2)
                    
                    if not novos_links:
                        if verbose: print(f"  [SDN]  Rede sem rota possível. Retransmitindo e aguardando Fail Duration")

                        tempo_perdido_fatal = FAIL_DURATION + tempo_viagem_neste_trecho
                        acumulado[3] += tempo_perdido_fatal

                        acumulado[0] += FAIL_DURATION
                        acumulado[0] += tempo_viagem_neste_trecho # Soma viagem perdida
                        acumulado[1] += 1
                        total_packets_lost_simulada += 1
                        l = 0 
                        tempo_viagem_neste_trecho = 0.0
                        
                        perda_idx += 1
                        continue
                    
                    if verbose: print(f"  [SDN] Nova rota encontrada! Continuando...")
                    
                    
                    rota_atual = novos_links 
                    
                    
                    acumulado[0] += tempo_viagem_neste_trecho
                    
                    tempo_viagem_neste_trecho = 0.0
                    l = 0 # Reinicia índice para a NOVA rota
                    perda_idx += 1 
                    continue 

                # === CENÁRIO 2: ERRO DE BIT (RETRANSMIT) ===
                else:
                    tipo_erro = "Bit Error LAN" if eh_lan else "Bit Error WAN"
                    if verbose: print(f"  [SDN] {tipo_erro} em {u}->{v}. Retransmitindo (+{int_to:.4f}s)...")

                    tempo_perdido_erro = int_to + tempo_viagem_neste_trecho
                    acumulado[3] += tempo_perdido_erro
                    
                    acumulado[0] += int_to
                    
                    acumulado[0] += tempo_viagem_neste_trecho 
                    
                    acumulado[1] += 1
                    total_packets_lost_simulada += 1
                    
                    l = 0 # Volta para o início
                    tempo_viagem_neste_trecho = 0.0

        if not perda:
            tempo_viagem_neste_trecho += passo
            
            if verbose: 
                print(f"  > {u}->{v} | T_sim: {acumulado[0] + tempo_viagem_neste_trecho:.4f}s [OK]")
            l += 1
            
        perda_idx += 1
        total_packets_sent_simulada += 1

    acumulado[0] += tempo_viagem_neste_trecho
    if (acumulado[0] >= reqlat): acumulado[2] = True

    if verbose: print(f"[FIM SDN] Tempo Total: {acumulado[0]:.4f}s | Perdas: {acumulado[1]}")
    return acumulado

# --- FUNÇÃO REPLICAÇÃO ---
def simular_com_replicacao(tg, nome_rede, links_pri, links_sec, reqlat, eventos_A, eventos_B, modo, lat_ctrl, int_to, verbose=False):
    global black_hole_state, total_packets_lost_simulada

    bh_state_A = copy.deepcopy(black_hole_state)
    bh_state_B = copy.deepcopy(black_hole_state)

    acc_A = [0, 0, False, False, 0.0] 
    acc_B = [0, 0, False, False, 0.0]
    viagem_A = 0.0; viagem_B = 0.0

    dest_final_A = links_pri[-1][1]
    dest_final_B = links_sec[-1][1]

    prefixes_lan = ('serv', 'fw', 'gate', 'sw', 'core')

    if verbose: 
        print(f"[{modo} + RES] Corrida iniciada. (A: Primário | B: Secundário)")

    l_A, l_B = 0, 0
    perda_idx = 0
    idx_B = 0

    while (not acc_A[3] or not acc_B[3]):
        

        # --- CAMINHO A ---
        if not acc_A[3]:
            if perda_idx >= len(eventos_A): acc_A[3] = True; continue
            u, v, bits, bw, lat, lr = links_pri[l_A]
            passo = (bits/(bw*1e6)) + (lat/1000.)
            t_chegada = acc_A[0] + viagem_A + passo
            is_lm = (lr == TAXA_PERDA_LR)
            perda = False
            msg_fail = ""
 
            eh_lan = u.startswith(prefixes_lan) or v.startswith(prefixes_lan)

            if modo == "TRAD":
                link_broken = (u == bh_state_A['u'] and v == bh_state_A['v'])
                in_time = (t_chegada < bh_state_A['active_until'])
                if link_broken and in_time and is_lm:
                    perda = True; msg_fail = "Buraco Negro"
                elif eventos_A[perda_idx] <= lr:
                    perda = True; msg_fail = "Erro"
                    if is_lm and t_chegada >= bh_state_A['active_until']:
                        bh_state_A['u'] = u; bh_state_A['v'] = v
                        bh_state_A['active_until'] = t_chegada + FAIL_DURATION
                
                if perda:
                    acc_A[1] += 1; total_packets_lost_simulada += 1

                    tempo_perdido = int_to + viagem_A
                    acc_A[4] += tempo_perdido

                    acc_A[0] += int_to
                    acc_A[0] += viagem_A 
                    viagem_A = 0.0; l_A = 0 
                    if verbose: print(f"  [A] FALHA {u}->{v} ({msg_fail}). Timeout...")

            else: # SDN
                if eventos_A[perda_idx] <= lr:
                    if is_lm and eh_lan:
                        perda = False
                    else:
                        perda = True
                        acc_A[1] += 1

                    if perda:
                        if is_lm: 

                            penalidade_ctrl = (2 * lat_ctrl)
                            acc_A[4] += penalidade_ctrl

                            acc_A[0] += (2 * lat_ctrl)
                            if verbose: print(f"  [A] SDN: Queda em {u}->{v}. Recalculando...")
                            nova_rota, _ = gerar_caminho_wan_k(tg, nome_rede, u, dest_final_A, bits, k=2)
                            if nova_rota:
                                links_pri = nova_rota
                                acc_A[0] += viagem_A 
                                l_A = 0; viagem_A = 0.0
                                if verbose: print(f"  [A] Nova rota com {len(links_pri)} saltos.")
                            
                            else:
                                msg_fail = "Rede sem rota possível. Retransmitindo e aguardando Fail Duration";

                                tempo_fatal = FAIL_DURATION + viagem_A
                                acc_A[4] += tempo_fatal

                                acc_A[0] += FAIL_DURATION
                                acc_A[0] += viagem_A # Soma tempo perdido
                                viagem_A = 0.0; l_A = 0
                                if verbose: print(f"  [A] FALHA {u}->{v} ({msg_fail}).")
                        else:
                            msg_fail = "Bit Error"; 

                            tempo_perdido = int_to + viagem_A
                            acc_A[4] += tempo_perdido

                            acc_A[0] += int_to
                            acc_A[0] += viagem_A # Soma tempo perdido
                            viagem_A = 0.0; l_A = 0 
                            if verbose: print(f"  [A] FALHA {u}->{v} ({msg_fail}).")

            if not perda:
                viagem_A += passo
                if verbose: print(f"  [A] {u}->{v} [OK] | T_sim: {acc_A[0] + viagem_A:.4f}s")
                l_A += 1
                if l_A == len(links_pri): acc_A[3] = True; acc_A[0] += viagem_A

            perda_idx += 1

        # --- CAMINHO B ---
        if not acc_B[3]:
            if idx_B >= len(eventos_B): acc_B[3] = True; continue
            u, v, bits, bw, lat, lr = links_sec[l_B]
            passo = (bits/(bw*1e6)) + (lat/1000.)
            t_chegada = acc_B[0] + viagem_B + passo
            is_lm = (lr == TAXA_PERDA_LR)
            perda = False
            msg_fail = ""

            eh_lan = u.startswith(prefixes_lan) or v.startswith(prefixes_lan)

            if modo == "TRAD":
                fail_A = (u == bh_state_A['u'] and v == bh_state_A['v']) and (t_chegada < bh_state_A['active_until'])
                fail_B = (u == bh_state_B['u'] and v == bh_state_B['v']) and (t_chegada < bh_state_B['active_until'])
                if (fail_A or fail_B) and is_lm:
                    perda = True; msg_fail = "Buraco Negro"
                elif eventos_B[idx_B] <= lr:
                    perda = True; msg_fail = "Erro"
                    if is_lm and t_chegada >= bh_state_B['active_until']:
                        bh_state_B['u'] = u; bh_state_B['v'] = v
                        bh_state_B['active_until'] = t_chegada + FAIL_DURATION
                
                if perda:
                    acc_B[1] += 1; total_packets_lost_simulada += 1

                    tempo_perdido = int_to + viagem_B
                    acc_B[4] += tempo_perdido

                    acc_B[0] += int_to
                    acc_B[0] += viagem_B 
                    viagem_B = 0.0; l_B = 0
                    if verbose: print(f"  [B] FALHA {u}->{v} ({msg_fail}). Timeout...")

            else: # SDN
                if eventos_B[idx_B] <= lr:
                    if is_lm and eh_lan:
                        perda = False
                    else:
                        perda = True
                        acc_B[1] += 1
                    
                    if perda:
                        if is_lm:

                            penalidade_ctrl = (2 * lat_ctrl)
                            acc_B[4] += penalidade_ctrl
 
                            acc_B[0] += (2 * lat_ctrl)
                            if verbose: print(f"  [B] SDN: Queda em {u}->{v}. Recalculando...")
                            nova_rota, _ = gerar_caminho_wan_k(tg, nome_rede, u, dest_final_B, bits, k=2)
                            if nova_rota:
                                links_sec = nova_rota
                                acc_B[0] += viagem_B
                                l_B = 0; viagem_B = 0.0
                                if verbose: print(f"  [B] Nova rota com {len(links_sec)} saltos.")
                            else:
                                msg_fail = "Rede sem rota possível. Retransmitindo e aguardando Fail Duration";

                                tempo_fatal = FAIL_DURATION + viagem_B
                                acc_B[4] += tempo_fatal
 
                                acc_B[0] += FAIL_DURATION
                                acc_B[0] += viagem_B
                                viagem_B = 0.0; l_B = 0 
                                if verbose: print(f"  [B] FALHA {u}->{v} ({msg_fail}).")
                        else:
                            msg_fail = "Bit Error";

                            tempo_perdido = int_to + viagem_B
                            acc_B[4] += tempo_perdido

                            acc_B[0] += int_to
                            acc_B[0] += viagem_B
                            viagem_B = 0.0; l_B = 0
                            if verbose: print(f"  [B] FALHA {u}->{v} ({msg_fail}).")

            if not perda:
                viagem_B += passo
                if verbose: print(f"  [B] {u}->{v} [OK] | T_sim: {acc_B[0] + viagem_B:.4f}s")
                l_B += 1
                if l_B == len(links_sec): acc_B[3] = True; acc_B[0] += viagem_B
            
            idx_B += 1

    if acc_A[3] and acc_B[3]:
        winner = "A" if acc_A[0] <= acc_B[0] else "B"
        res = acc_A if winner == "A" else acc_B
    elif acc_A[3]: winner = "A"; res = acc_A
    elif acc_B[3]: winner = "B"; res = acc_B
    else: return [max(acc_A[0], acc_B[0]), max(acc_A[1], acc_B[1]), True, max(acc_A[4], acc_B[4])]

    # --- PRINT FINAL COMPARATIVO ---
    if verbose:
        time_a_str = f"{acc_A[0]:.4f}s" if acc_A[3] else "N/A"
        time_b_str = f"{acc_B[0]:.4f}s" if acc_B[3] else "N/A"
        print(f"[FIM RES] Vencedor: {winner} | Tempo: {res[0]:.4f}s | (A: {time_a_str} vs B: {time_b_str})")
        
    return [res[0], res[1], res[0] >= reqlat, res[4]]

