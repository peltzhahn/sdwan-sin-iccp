def gerar_caminho_wan_k(gerador_topologia, nome_rede, node_origem, node_destino, bits_msg_default, k=1):
    network, _ = gerador_topologia.generateNetwork(nome_rede)
    try:
        paths_generator = nx.shortest_simple_paths(network, source=node_origem, target=node_destino, weight='weight')
        path_nodes = []
        for i, path in enumerate(paths_generator):
            if i == k - 1:
                path_nodes = path
                break
        if not path_nodes: return [], None
        print(path_nodes)
    except: return [], None

    caminho_links = []
    lr_wan = BER_WAN

    for i in range(len(path_nodes) - 1):
        u = path_nodes[i]
        v = path_nodes[i+1]
        edge_data = network.get_edge_data(u, v)
        if edge_data:
            distance_km = edge_data['weight']
            # Propagação usa velocidade da luz no vácuo (300 km/ms)
            latencia_prop_ms = distance_km / 300.0 
            
            
            bw_mbps = edge_data['bandwidth'] 
            
            caminho_links.append((u, v, bits_msg_default, bw_mbps, latencia_prop_ms, lr_wan))

    return caminho_links, network.get_edge_data

def gerar_caminho_wan(gerador, nome, orig, dest, bits):
    return gerar_caminho_wan_k(gerador, nome, orig, dest, bits, k=1)

def get_latency_to_controller(node_origem, node_controller):
    if node_origem == node_controller: return 0.0
    tg_temp = TopologyGenerator()
    network, _ = tg_temp.generateNetwork("rnp")
    try:
        dist_km = nx.shortest_path_length(network, source=node_origem, target=node_controller, weight='weight')
        latencia_ms = dist_km / 300.0
        return latencia_ms / 1000.0
    except: return 0.05

